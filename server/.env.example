# Copy to server/.env and adjust. Nothing here is a third-party secret; AWS credentials come from
# the normal AWS config (aws configure), never from this file.

PORT=8787

# Phones need HTTPS for the microphone. Option A: a tunnel URL.
# PUBLIC_URL=https://your-name.trycloudflare.com
PUBLIC_URL=

# Option B: serve HTTPS directly with a local certificate (self-signed: tap "Advanced > Proceed" once on the phone).
TLS_CERT_FILE=../certs/test.pem
TLS_KEY_FILE=../certs/test-key.pem
# With TLS on, also offer plain HTTP for the TV on the same Wi-Fi (the TV does not trust a self-signed cert).
TV_HTTP_PORT=8788

# Speech recognition on the server with Amazon Transcribe (needs the AWS account to have Transcribe enabled).
# Leave unset: each phone recognises speech itself (browser Web Speech API).
# SERVER_SPEECH=transcribe

# Spoken replies use Amazon Polly (us-east-1). Set TTS=off to disable.
# TTS=off

DATA_DIR=data

# Measurement sessions only: save caption text to data/captured.jsonl for word-error-rate scoring.
# Phones show a warning that captions are being saved. Leave off for normal family use.
# CAPTURE_TEXT=1
